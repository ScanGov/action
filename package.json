{
  "name": "scangov",
  "version": "1.0.1",
  "description": "Audit a static site against ScanGov standards inside CI, before it deploys.",
  "license": "MIT",
  "repository": "github:ScanGov/action",
  "homepage": "https://scangov.org",
  "type": "module",
  "bin": {
    "scangov": "src/cli.mjs"
  },
  "files": [
    "src",
    "scripts"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node --test && node src/cli.mjs --site-dir fixtures/site --base-path /fixture/ --canonical-domain example.gov --report-dir .scangov-test --dry-run",
    "smoke": "node src/cli.mjs --site-dir fixtures/site --base-path /fixture/ --canonical-domain example.gov --report-dir .scangov-test",
    "set-version": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "automated-readability": "^2.0.1",
    "chrome-launcher": "^1.2.0",
    "lighthouse": "13.5.0",
    "linkedom": "^0.18.11",
    "natural": "8.1.0",
    "unfluff": "^3.2.0"
  }
}
